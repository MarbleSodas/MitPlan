# XIVMitPlan web app — Supabase connection
#
# Copy this file to `.env` (or `.env.local`) and fill in your project's
# values from the Supabase dashboard (Project Settings → API).
#
# - VITE_SUPABASE_URL:        Project URL, e.g. https://<ref>.supabase.co
# - VITE_SUPABASE_ANON_KEY:   "anon" public key (safe to expose to browsers)
#
# The service_role key must NEVER be placed here or shipped to the client;
# edge functions receive it automatically from the Supabase runtime.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-public-key>
