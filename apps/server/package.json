{
  "name": "@xivmitplan/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "XIVMitPlan API — Hono on Cloudflare Workers. tRPC + REST shim. See docs/adr/0001.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@xivmitplan/domain": "workspace:*",
    "@xivmitplan/persistence": "workspace:*",
    "@xivmitplan/shared": "workspace:*",
    "@xivmitplan/validation": "workspace:*",
    "@supabase/supabase-js": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@trpc/server": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:",
    "vitest": "catalog:",
    "@vitest/ui": "catalog:",
    "@types/node": "catalog:",
    "testcontainers": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:"
  }
}
