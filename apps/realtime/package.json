{
  "name": "@xivmitplan/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "XIVMitPlan realtime — Hocuspocus on Cloudflare Durable Object via y-partyserver. One DO per plan. See architecture §14.6 and docs/adr/0001.",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir=dist",
    "deploy": "wrangler deploy",
    "tail": "wrangler tail",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:stress": "vitest run --config vitest.stress.config.ts"
  },
  "dependencies": {
    "@xivmitplan/crdt": "workspace:*",
    "@xivmitplan/persistence": "workspace:*",
    "@xivmitplan/shared": "workspace:*",
    "@xivmitplan/validation": "workspace:*",
    "yjs": "catalog:",
    "y-protocols": "catalog:",
    "y-partyserver": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "wrangler": "catalog:",
    "vitest": "catalog:",
    "@vitest/ui": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "prettier": "catalog:",
    "tsx": "catalog:"
  }
}
