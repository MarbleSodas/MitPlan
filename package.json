{
  "name": "mitplanffxiv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:realtime": "vitest run src/App.routes.test.tsx src/services/legacyLocalPlanImportService.test.ts",
    "test:collaboration": "vitest run src/contexts/CollaborationContext.test.tsx src/contexts/PresenceContext.test.tsx src/services/presenceService.test.ts src/services/presenceService.subscription.test.ts src/services/sessionManager.test.ts src/components/planner/MitigationPlanner.collaboration.test.tsx",
    "test:persistence": "vitest run src/tests/integration/data-persistence-recovery.test.js",
    "test:performance": "vitest run src/tests/performance/realtime-performance.test.jsx",
    "timeline": "bun run --cwd scripts/timeline-scraper src/cli.ts",
    "timeline:accuracy": "node scripts/timelineAccuracyAnalyzer.js",
    "data:inventory": "bun scripts/officialDataInventory.ts",
    "data:validate": "bun scripts/officialDataInventory.ts --check",
    "data:apply-diff": "bun scripts/applyOfficialDataDiff.ts",
    "security:check": "node scripts/security-check.js",
    "security:scan": "node scripts/security-check.js --ci --scan-only",
    "verify:database": "supabase migration list",
    "types:database": "supabase gen types typescript --local > src/types/database.types.ts",
    "deploy:database": "supabase db push",
    "migrate:firebase:dry-run": "node scripts/migrate-firebase-to-supabase.mjs",
    "migrate:firebase:apply": "node scripts/migrate-firebase-to-supabase.mjs --apply",
    "migrate:plans:backfill": "node scripts/backfill-normalized-plans.mjs",
    "repair:firebase-passwords": "node scripts/repair-firebase-password-hashes.mjs",
    "predeploy": "bun run security:check && bun run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/supabase-js": "2.110.5",
    "@tailwindcss/postcss": "4.3.2",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.561.0",
    "next": "16.2.10",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.25",
    "firebase-tools": "^15.0.0",
    "globals": "^16.5.0",
    "jsdom": "^27.3.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.15",
    "ws": "^8.18.3"
  }
}
