# XIVMitPlan v1 — env example
# Copy to .env.local at the repo root. Do NOT commit the .env.local.
# Per architecture §16.4: all secrets in Cloudflare Workers Secrets for
# deploy. This file is for local dev only.

# --- Supabase ------------------------------------------------------------
# Create at https://supabase.com/dashboard (one project per environment).
# Free tier is sufficient for dev.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Found in Project Settings → API → JWT Secret. Used for HS256 verification.
SUPABASE_JWT_SECRET=<jwt-secret>

# --- Database (Postgres connection string) --------------------------------
# Format: postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# --- Upstash Redis --------------------------------------------------------
# Create at https://console.upstash.com (free tier: 500K cmds/mo).
UPSTASH_REDIS_URL=https://<instance>.upstash.io
UPSTASH_REDIS_TOKEN=<token>

# --- Cloudflare R2 (backups) ----------------------------------------------
# Free tier: 10GB, 1M Class A ops, 10M Class B, free egress.
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key>
R2_SECRET_ACCESS_KEY=<secret-key>
R2_BACKUPS_BUCKET=xivmitplan-backups-dev

# --- Discord OAuth --------------------------------------------------------
# Create at https://discord.com/developers/applications.
# Add a redirect URI: http://localhost:5173/auth/callback (dev) +
# https://app.xivmit.com/auth/callback (prod).
DISCORD_OAUTH_CLIENT_ID=<client-id>
DISCORD_OAUTH_CLIENT_SECRET=<client-secret>

# --- Google OAuth ---------------------------------------------------------
# Create at https://console.cloud.google.com/apis/credentials.
# Add a redirect URI: http://localhost:5173/auth/callback (dev) +
# https://app.xivmit.com/auth/callback (prod).
GOOGLE_OAUTH_CLIENT_ID=<client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>

# --- FFLogs OAuth ---------------------------------------------------------
# Create at https://www.fflogs.com/api/clients/.
FFLOGS_OAUTH_CLIENT_ID=<client-id>
FFLOGS_OAUTH_CLIENT_SECRET=<client-secret>

# --- App ------------------------------------------------------------------
ENVIRONMENT=dev
JWT_SIGNING_KEY=<openssl rand -base64 32>

# Comma-separated list of allowed origins for CORS.
CORS_ORIGINS=http://localhost:5173

# --- Sentry (optional) ----------------------------------------------------
SENTRY_DSN=

# --- Honeycomb (optional) -------------------------------------------------
HONEYCOMB_API_KEY=

# --- Realtime Worker ------------------------------------------------------
# In dev, wrangler binds the DO locally. In prod, this is the deployed URL.
REALTIME_HOST=localhost:1999
SUPABASE_JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# --- Web (Vite) -----------------------------------------------------------
# Exposed to the client (Vite prefix). Do NOT put secrets here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
VITE_REALTIME_HOST=localhost:1999
