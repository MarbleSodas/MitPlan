# XIVMitPlan v1 — env example
# Copy to .env.local at the repo root. Do NOT commit the .env.local.
#
# Per ADR-0002 + ADR-0003: Path A Hardened uses Supabase for everything
# (Realtime, PostgREST, Edge Functions, Auth). The only required env
# vars for the web app are the VITE_-prefixed Supabase URL + anon key
# — every other line is optional and powers specific Edge Functions
# or integrations.
#
# The bootstrap script `scripts/supabase-bootstrap.sh` reads a
# `apps/edge/.env.<env>` file for Edge Function secrets. Copy this
# file to that location too, with Edge-specific vars filled in.

# =========================================================================
# Supabase — REQUIRED for the web app
# =========================================================================
# Create at https://supabase.com/dashboard (one project per environment).
# Free tier is sufficient for dev. The anon key is safe to ship to
# clients (RLS enforces auth); the service-role key is admin-only.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# Found in Project Settings → API → JWT Secret. Used for HS256 verification.
SUPABASE_JWT_SECRET=<jwt-secret>

# =========================================================================
# Database (Postgres connection string)
# =========================================================================
# Format: postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
# Only needed if you want to run migrations / psql manually (the
# bootstrap script can also apply them via `supabase db push`).
DATABASE_URL=postgres://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# =========================================================================
# Cloudflare R2 (backups) — OPTIONAL, not yet wired in v1
# =========================================================================
# Free tier: 10GB, 1M Class A ops, 10M Class B, free egress.
# Reserved for the v1.x post-launch snapshot backup job (architecture
# §17.7.4). Not required for the FRU demo to work.
R2_ACCOUNT_ID=<account-id>
R2_ACCESS_KEY_ID=<access-key>
R2_SECRET_ACCESS_KEY=<secret-key>
R2_BACKUPS_BUCKET=xivmitplan-backups-dev

# =========================================================================
# OAuth (one per provider, set in the Supabase Dashboard too)
# =========================================================================
# Create the OAuth app, then paste Client ID + Secret in BOTH the
# provider's dashboard AND the Supabase Dashboard (Authentication →
# Providers). The Supabase env values let the Edge Function runtime
# mint its own short-lived tokens for the timelines-ingest-fflogs flow.
DISCORD_OAUTH_CLIENT_ID=<client-id>
DISCORD_OAUTH_CLIENT_SECRET=<client-secret>

GOOGLE_OAUTH_CLIENT_ID=<client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>

FFLOGS_OAUTH_CLIENT_ID=<client-id>
FFLOGS_OAUTH_CLIENT_SECRET=<client-secret>
# Personal access token for the FFLogs API. Used by the
# timelines-ingest-fflogs Edge Function for cron polling.
FFLOGS_OAUTH_TOKEN=<fflogs-pat>

# =========================================================================
# App
# =========================================================================
ENVIRONMENT=dev
# 32-byte random string for signing share-link tokens. Generate with
# `openssl rand -base64 32`. The plans-share Edge Function reads this.
JWT_SIGNING_KEY=<openssl rand -base64 32>

# Comma-separated list of allowed origins for CORS on the Edge
# Functions. Include the web app's origin(s) + localhost for dev.
CORS_ORIGINS=http://localhost:5173

# =========================================================================
# Observability (optional)
# =========================================================================
SENTRY_DSN=
HONEYCOMB_API_KEY=

# =========================================================================
# Web (Vite) — exposed to the client bundle
# =========================================================================
# Both values are safe to commit to a public bundle; the anon key is
# designed for client-side use. RLS still gates every database call.
# Without these two vars set, the web app boots in "fallback mode"
# (sample-data + no realtime) — useful for offline dev but not for
# the live demo.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>
