{
  "name": "@xivmitplan/crdt",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "XIVMitPlan CRDT — Yjs document shape + awareness + validators. See architecture §14.1 (PlanDoc shape) and §14.3 (presence).",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema.ts",
    "./awareness": "./src/awareness.ts",
    "./factory": "./src/factory.ts",
    "./validator": "./src/validator.ts"
  },
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose",
    "test:property": "vitest run --reporter=verbose --dir src/__tests__"
  },
  "dependencies": {
    "@xivmitplan/shared": "workspace:*",
    "@xivmitplan/validation": "workspace:*",
    "yjs": "catalog:",
    "y-protocols": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@vitest/ui": "catalog:",
    "fast-check": "catalog:",
    "happy-dom": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "prettier": "catalog:"
  }
}
