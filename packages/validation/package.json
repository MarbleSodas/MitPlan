{
  "name": "@xivmitplan/validation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "XIVMitPlan validation — All Zod schemas. Single source of truth for HTTP request/response shapes, Yjs document field types, FFLogs/Triggernometry parser input validation, and Drizzle insert/select types (via drizzle-zod). See architecture §7.11 and §18.6.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./auth": "./src/auth/index.ts",
    "./plan": "./src/plan/index.ts",
    "./timeline": "./src/timeline/index.ts",
    "./cactbot": "./src/cactbot/index.ts",
    "./triggernometry": "./src/triggernometry/index.ts",
    "./fflogs": "./src/fflogs/index.ts",
    "./ability": "./src/ability/index.ts"
  },
  "scripts": {
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --reporter=verbose"
  },
  "dependencies": {
    "@xivmitplan/shared": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "vitest": "catalog:",
    "@vitest/ui": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "eslint": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "prettier": "catalog:"
  }
}
